@prefix aiprov: <https://w3id.org/aiprov/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix agent: <https://example.org/prov/agent/> .
@prefix act: <https://example.org/prov/activity/> .
@prefix ent: <https://example.org/prov/entity/> .

# Synthetic. One answer generated by two model activities; a fallback of itself; a fallback of an activity never logged.
agent:m1 a aiprov:AIAgent .
agent:m2 a aiprov:AIAgent .
act:first a aiprov:AuthoringPass ; prov:endedAtTime "2026-10-30T12:00:00+00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith agent:m1 ; aiprov:modelRole "answer" .
act:second a aiprov:AuthoringPass ; prov:endedAtTime "2026-10-30T12:01:00+00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith agent:m2 ; aiprov:modelRole "answer" ; aiprov:fallbackOf act:second .
act:third a aiprov:AuthoringPass ; prov:endedAtTime "2026-10-30T12:02:00+00:00"^^xsd:dateTime ;
    prov:wasAssociatedWith agent:m2 ; aiprov:fallbackOf act:ghost .
ent:reply-md a aiprov:Artefact ; prov:wasGeneratedBy act:first, act:second .
