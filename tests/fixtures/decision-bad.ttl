@prefix aiprov: <https://w3id.org/aiprov/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix agent: <https://example.org/prov/agent/> .
@prefix act: <https://example.org/prov/activity/> .
@prefix dec: <https://example.org/prov/decision/> .
@prefix opt: <https://example.org/prov/option/> .

# Synthetic. Defects: a decision without a hash and with one option (malformed); a deciding activity that chose an
# option of another decision; one set to done by an AI; a supersedes link to a decision that does not exist.
agent:planner a aiprov:AIAgent ; aiprov:model "m-1" .
dec:d1 a aiprov:Decision ; prov:wasAttributedTo agent:planner ; aiprov:supersedes dec:missing .
opt:d1-a a aiprov:Option ; aiprov:optionOf dec:d1 ; aiprov:contentHash "sha256:ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb" .
dec:d2 a aiprov:Decision ; prov:wasAttributedTo agent:planner ;
    aiprov:contentHash "sha256:3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d" .
opt:d2-a a aiprov:Option ; aiprov:optionOf dec:d2 ; aiprov:contentHash "sha256:ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb" .
opt:d2-b a aiprov:Option ; aiprov:optionOf dec:d2 ; aiprov:contentHash "sha256:3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d" .
act:decide-d2-1 a aiprov:Deciding ; prov:used dec:d2 ; prov:wasAssociatedWith agent:planner ;
    aiprov:chosenOption opt:d1-a ; aiprov:decisionState aiprov:decisionState-done ;
    prov:endedAtTime "2026-11-01T09:00:00+00:00"^^xsd:dateTime .
