@prefix aiprov: <https://w3id.org/aiprov/ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix agent: <https://example.org/prov/agent/> .
@prefix act: <https://example.org/prov/activity/> .
@prefix chan: <https://example.org/prov/channel/> .
@prefix msg: <https://example.org/prov/message/> .

# Synthetic. Three separate defects: a sender that was never registered, a reply to a message that does not exist,
# and a message without a content hash.
agent:planner a aiprov:AIAgent ; aiprov:model "m-1" .
chan:team a aiprov:Channel ; aiprov:dataClass "internal" .
msg:ghost-sender a aiprov:Message ; prov:wasAttributedTo agent:ghost ; aiprov:inChannel chan:team ;
    aiprov:contentHash "sha256:ca978112ca1bbdcafac231b39a23dc4da786eff8147c4e72b9807785afee48bb" .
msg:lost-reply a aiprov:Message ; prov:wasAttributedTo agent:planner ; aiprov:inChannel chan:team ;
    aiprov:contentHash "sha256:3e23e8160039594a33894f6564e1b1348bbd7a0088d42c4acb73eeaed59c009d" ; aiprov:inReplyTo msg:nowhere .
msg:no-hash a aiprov:Message ; prov:wasAttributedTo agent:planner ; aiprov:inChannel chan:team .
