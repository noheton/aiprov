verif:ai-confirmed a aiprov:VerificationState ;
    rdfs:label "AI-confirmed"@en ;
    rdfs:comment "An AI agent checked that the source CONTENT supports the associated claim (abstract/full-text cross-check). This is the highest rung an AI may grant; it is a machine judgement, not a human one."@en ;
    aiprov:ladderPosition 3 .

verif:human-confirmed a aiprov:VerificationState ;
    rdfs:label "human-confirmed"@en ;
    rdfs:comment "A HUMAN checked that the source supports the claim (targeted spot-check, not necessarily a full read). Human-only: an AI agent must never grant this rung."@en ;
    aiprov:ladderPosition 5 .

verif:human-read a aiprov:VerificationState ;
    rdfs:label "human-read"@en ;
    rdfs:comment "A HUMAN has read the source in full. Top of the ladder; consolidates the former lit-read rung. Human-only: an AI agent must never grant this rung."@en ;
    skos:altLabel "lit-read"@en ;
    aiprov:ladderPosition 6 .

verif:needs-research a aiprov:VerificationState ;
    rdfs:label "needs research"@en ;
    rdfs:comment "A check was attempted or demanded and did not succeed (e.g. DOI did not resolve). Must not be cited or relied upon until re-verified."@en ;
    aiprov:ladderPosition 1 .

verif:reference-resolved a aiprov:VerificationState ;
    rdfs:label "reference resolved"@en ;
    rdfs:comment "The reference EXISTS: its DOI/URL resolved in a bibliographic registry (Crossref, OpenAlex, DataCite) and metadata was captured. Says nothing about whether the content supports anything."@en ;
    skos:altLabel "lit-retrieved"@en,
        "retrieved"@en ;
    aiprov:ladderPosition 2 .

verif:source-vendored a aiprov:VerificationState ;
    rdfs:label "source vendored"@en ;
    rdfs:comment "A copy of the source is preserved inside the repository, immune to link rot; the vendored bytes are what any later audit reads."@en ;
    aiprov:ladderPosition 4 .

aiprov:Build a owl:Class ;
    rdfs:comment "Deterministic build/compile/CI activity."@en ;
    rdfs:subClassOf prov:Activity .

aiprov:AuthoringPass a owl:Class ;
    rdfs:comment "AI or human produces/edits an artefact."@en ;
    rdfs:subClassOf prov:Activity .

aiprov:HumanAgent a owl:Class ;
    rdfs:label "Human agent"@en ;
    rdfs:subClassOf prov:Person .

aiprov:Repair a owl:Class ;
    rdfs:comment "Fixes a structural defect in the graph itself (e.g. backfilled parent)."@en ;
    rdfs:subClassOf prov:Activity .

aiprov:AIAgent a owl:Class ;
    rdfs:label "AI agent"@en ;
    rdfs:comment "An LLM- or ML-driven agent participating in artefact production."@en ;
    rdfs:subClassOf prov:SoftwareAgent .

aiprov:Contribution a owl:Class ;
    rdfs:subClassOf prov:Entity .

