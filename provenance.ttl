<https://w3id.org/aiprov/prov/claim/c-extract-dashboard-fix> a aiprov:Claim ;
    rdfs:label "extract --dashboard failed because provlog.py imported build_dashboard as a top-level module; importing it from the aiprov package fixes it, shown by a new test that fails before and passes after the change."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-extract-dashboard-import> ;
