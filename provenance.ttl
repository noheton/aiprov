        "edit",
        "read",
        "write" .

aiprov:VerificationState a owl:Class ;
    rdfs:comment "A rung on the verification ladder. Higher position = stronger check. Rungs at position 5+ are human-only: an AI agent must never grant them."@en .

aiprov:Artefact a owl:Class ;
    rdfs:comment "Generalizes Manuscript/Section/Figure: any produced file or object."@en ;
    rdfs:subClassOf prov:Entity .

