@prefix agent: <https://w3id.org/aiprov/prov/agent/> .
@prefix aiprov: <https://w3id.org/aiprov/ns#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix verif: <https://w3id.org/aiprov/prov/verification/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aiprov:AIContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:AuditPass a owl:Class ;
    rdfs:comment "AI or human reviews, verifies, or contests an artefact."@en ;
    rdfs:subClassOf prov:Activity .

aiprov:HumanContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:MetaContribution a owl:Class ;
    rdfs:subClassOf aiprov:Contribution .

aiprov:Prompt a owl:Class ;
    rdfs:comment "A versioned prompt file. Bind to activities via prov:qualifiedAssociation/prov:hadPlan or dcterms:source."@en ;
    rdfs:subClassOf prov:Plan .

aiprov:Source a owl:Class ;
    rdfs:subClassOf prov:Entity .

aiprov:ToolAgent a owl:Class ;
    rdfs:label "Deterministic tool"@en ;
    rdfs:comment "Non-AI software (compiler, linter, CI job) acting in the pipeline."@en ;
    rdfs:subClassOf prov:SoftwareAgent .

aiprov:Transcript a owl:Class ;
    rdfs:comment "Preserved conversation record; bound to activities via aiprov:transcript."@en ;
    rdfs:subClassOf prov:Entity .

aiprov:affiliation a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:cacheReadTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:cacheWriteTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:contentHash a owl:DatatypeProperty ;
    rdfs:comment "sha256 of the artefact bytes at generation time."@en ;
    rdfs:range xsd:string .

aiprov:contextWindow a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:contradicts a owl:ObjectProperty ;
    rdfs:domain aiprov:Claim ;
    rdfs:range aiprov:Claim .

aiprov:cost a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:costCurrency a owl:DatatypeProperty ;
    rdfs:comment "ISO 4217, e.g. EUR, USD."@en ;
    rdfs:range xsd:string .

aiprov:doi a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI .

aiprov:endpoint a owl:DatatypeProperty ;
    rdfs:comment "API endpoint or gateway URL through which the model was reached."@en ;
    rdfs:range xsd:anyURI .

aiprov:energyWh a owl:DatatypeProperty ;
    rdfs:comment "Optional energy estimate for the inference, in watt-hours."@en ;
    rdfs:range xsd:decimal .

aiprov:filePath a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:gitCommit a owl:DatatypeProperty ;
    rdfs:comment "Commit hash binding the entity to repository state."@en ;
    rdfs:range xsd:string .

aiprov:inputTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:knowledgeCutoff a owl:DatatypeProperty ;
    rdfs:range xsd:date .

aiprov:ladderPosition a owl:DatatypeProperty ;
    rdfs:comment "Total order of the ladder; promotions must strictly increase this value."@en ;
    rdfs:domain aiprov:VerificationState ;
    rdfs:range xsd:integer .

aiprov:maxTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:model a owl:DatatypeProperty ;
    rdfs:comment "Model identifier, e.g. claude-fable-5."@en ;
    rdfs:domain aiprov:AIAgent ;
    rdfs:range xsd:string .

aiprov:modelVersion a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:orcid a owl:DatatypeProperty ;
    rdfs:domain aiprov:HumanAgent ;
    rdfs:range xsd:anyURI .

aiprov:outputTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:promptHash a owl:DatatypeProperty ;
    rdfs:comment "Content hash (e.g. sha256) of the exact prompt text used."@en ;
    rdfs:range xsd:string .

aiprov:provider a owl:DatatypeProperty ;
    rdfs:comment "e.g. Anthropic, local/llama.cpp, gateway name."@en ;
    rdfs:range xsd:string .

aiprov:reasoningTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:repairs a owl:ObjectProperty ;
    rdfs:comment "A Repair activity amends generation metadata of a claim without invalidating its content."@en .

aiprov:requestId a owl:DatatypeProperty ;
    rdfs:comment "Provider request ID for a single inference call."@en ;
    rdfs:range xsd:string .

aiprov:seed a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:sessionId a owl:DatatypeProperty ;
    rdfs:comment "Client session identifier (e.g. Claude Code session UUID)."@en ;
    rdfs:range xsd:string .

aiprov:stopReason a owl:DatatypeProperty ;
    rdfs:range xsd:string .

aiprov:systemPromptRef a owl:ObjectProperty ;
    rdfs:comment "Links an activity to the system-prompt entity in force."@en .

aiprov:temperature a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:toolCalls a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:topP a owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

aiprov:totalTokens a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:transcript a owl:ObjectProperty ;
    rdfs:comment "Links the activity to a preserved conversation transcript entity."@en .

aiprov:turnCount a owl:DatatypeProperty ;
    rdfs:range xsd:integer .

aiprov:usedTool a owl:DatatypeProperty ;
    rdfs:comment "Repeatable: one value per distinct tool invoked (web_search, bash, ...)."@en ;
    rdfs:range xsd:string .

aiprov:verificationState a owl:ObjectProperty ;
    rdfs:comment "Current rung of a claim or source on the verification ladder. Exactly one value; transitions are recorded as AuditPass activities so the history stays in the graph."@en ;
    rdfs:domain aiprov:Claim ;
    rdfs:range aiprov:VerificationState .

<https://w3id.org/aiprov/prov/claim/c-adopt-aiprov> a aiprov:Claim ;
    rdfs:label "The repository validates its own provenance graph in CI (job provenance) and by a test, states rules for AI agents in AGENTS.md without internal information, and asks for an AI-assistance block in every pull request."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/adopt-aiprov> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-demo-page-live-check> a aiprov:Claim ;
    rdfs:label "site/build.py checks the exit code of each of its nine provlog commands (the human-read attempt by the AI must exit 1, validate must exit 0) and refuses to build when the graph holds a node without a place in the figure, so the page cannot show behaviour the code at that commit does not have."@en ;
    prov:wasAttributedTo agent:claude-opus-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/demo-page> ;
    aiprov:verificationState verif:ai-confirmed .

<https://w3id.org/aiprov/prov/claim/c-extract-dashboard-fix> a aiprov:Claim ;
    rdfs:label "extract --dashboard failed because provlog.py imported build_dashboard as a top-level module; importing it from the aiprov package fixes it, shown by a new test that fails before and passes after the change."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-extract-dashboard-import> ;
    aiprov:verificationState verif:ai-confirmed .

<https://w3id.org/aiprov/prov/claim/c-human-steps-fix> a aiprov:Claim ;
    rdfs:label "provlog claim and source now refuse human-confirmed, human-read and lit-read unless the agent is a registered HumanAgent, as promote does. Six new tests in tests/test_human_steps.py cover refusal, acceptance by a registered human, an unchanged graph file after a refusal and the ai-confirmed control. The suite passed with 30 tests on CPython 3.13 (uv run --extra dev pytest -q); CI on 3.10 and 3.12 was not run locally."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-human-only-steps> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-human-steps-scope> a aiprov:Claim ;
    rdfs:label "Not changed by the fix: claim still accepts states outside the ladder (adopters record contested), validate still only warns for a graph edited by hand, and nothing checks an AuditPass written outside provlog."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-human-only-steps> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-logo-provenance> a aiprov:Claim ;
    rdfs:label "The three badge files are byte-identical to the output of assets/make_icon.py run on the source picture (sha256 checked twice); the source is the inline image the owner pasted into the session, 1024 x 1024 px, sha256 670dc0f0. Model setting and prompt use are the owner's statements."@en ;
    prov:wasAttributedTo agent:claude-opus-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/logo-salmon-badge> ;
    aiprov:verificationState verif:ai-confirmed .

<https://w3id.org/aiprov/prov/claim/c-merge-hardened> a aiprov:Claim ;
    rdfs:label "After the second review, merge refuses count-neutral regressions, unwitnessed human-only rungs, demotions, retyping, unreadable shards, and is independent of shard order; plan bindings tie an agent to a role; 22 tests pass on Python 3.10 and 3.13."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/merge-hardening> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-merge-tested> a aiprov:Claim ;
    rdfs:label "provlog merge unions shards append-only, refuses a shard that edits a frozen plan or adds a validation failure, still merges the other shards, and leaves one verification state per node; 14 tests pass on Python 3.10 and 3.13."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/merge-command> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-orch-prov-semantics> a aiprov:Claim ;
    rdfs:label "prov:wasInformedBy for sub-activity to orchestration and prov:actedOnBehalfOf for agent instance to orchestrating agent are used in line with PROV-O semantics."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/orchestration-extension> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-orch-review-fixed> a aiprov:Claim ;
    rdfs:label "A review by nine agents (three lenses, a skeptic per finding) confirmed six findings and refuted none; they reduce to two defects, re-logging and plan bypass by omission, and both are fixed and covered by tests. Six further findings were reported but not verified (cap of two per lens)."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/orchestration-review-fixes> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-orch-rules-tested> a aiprov:Claim ;
    rdfs:label "The three new validator rules fail on tests/fixtures/orchestration-bad.ttl and find nothing on graphs without orchestrations; the 8 tests pass on Python 3.10 and 3.13."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/orchestration-extension> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-promote-off-ladder> a aiprov:Claim ;
    rdfs:label "promote now exits with a message when the state of a node is not on the ladder, instead of a ValueError traceback. Found by reproducing issue 18 with claim --state bogus followed by promote."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-human-only-steps> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-release-rc1> a aiprov:Claim ;
    rdfs:label "Version 0.2.0-rc.1 is set in pyproject.toml, the package, CITATION.cff and codemeta.json, and the CHANGELOG entry replaces Unreleased; 23 tests pass on Python 3.12."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/release-0-2-0-rc-1> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-review-fixes-pr19> a aiprov:Claim ;
    rdfs:label "A second agent reviewed pull request 19 and found that claim accepted states such as x/human-read and Human-Read, that an agent can register itself as a human and then pass the check, and that a human claim with a human-only state leaves no promotion record. The first is fixed (one lower-case token, tested); the other two are documented in AGENTS.md and CHANGELOG.md, not changed. The suite passed with 32 tests on CPython 3.13; run against the old provlog.py in a scratch copy, 5 of the 8 tests in tests/test_human_steps.py failed and the 3 acceptance and control cases passed."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/fix-human-only-steps-review> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/c-zenodo-records> a aiprov:Claim ;
    rdfs:label "Zenodo holds aiprov 0.1.0 as 10.5281/zenodo.23651334 and 0.2.0 as 10.5281/zenodo.23651340 under the concept DOI 10.5281/zenodo.23651333, open access, MIT; each archived zip has the same md5 as git archive of its tag (513e8a2e for v0.1.0, 3ff23479 for v0.2.0), checked through Zenodo's public records API on 2026-10-25."@en ;
    prov:wasAttributedTo agent:claude-opus-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/zenodo-archive> ;
    aiprov:verificationState verif:ai-confirmed .

<https://w3id.org/aiprov/prov/claim/fix-21-refusal> a aiprov:Claim ;
    rdfs:label "log, claim, source and promote exit non-zero and leave the graph unchanged for an agent id without an AIAgent, HumanAgent or ToolAgent type; validate fails on such a reference (37 tests pass)."@en ;
    prov:wasAttributedTo agent:claude-opus-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-fix-21-unregistered-agents> ;
    aiprov:verificationState verif:ai-confirmed .

