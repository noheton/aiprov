aiprov:VerificationState a owl:Class ;
    rdfs:comment "A rung on the verification ladder. Higher position = stronger check. Rungs at position 5+ are human-only: an AI agent must never grant them."@en .

aiprov:AuthoringPass a owl:Class ;
    rdfs:comment "AI or human produces/edits an artefact."@en ;
    rdfs:subClassOf prov:Activity .

verif:unverified a aiprov:VerificationState ;
    rdfs:label "unverified"@en ;
    rdfs:comment "Recorded, nothing checked yet by anyone. Default state at creation."@en ;
    aiprov:ladderPosition 0 .

aiprov:Claim a owl:Class ;
    rdfs:comment "An assertion in any artefact that warrants attribution and verification."@en ;
    rdfs:subClassOf prov:Entity .

