<https://w3id.org/aiprov/prov/claim/migrate-keeps-triples> a aiprov:Claim ;
    rdfs:label "provlog migrate keeps every triple of the 0.1.0 and 0.2.0 fixtures and a second run changes nothing (tests/test_migrate.py, 44 passed on CPython 3.12)."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-migrate-schema-version> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/migrate-version-detection> a aiprov:Claim ;
    rdfs:label "A graph without aiprov:schemaVersion is detected as 0.2.0 when it has aiprov:Orchestration or aiprov:plannedRole, otherwise as 0.1.0; this is a heuristic over the vocabulary, not a proof of the writing version."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-migrate-schema-version> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/multi-model-legacy-unchanged> a aiprov:Claim ;
    rdfs:label "Graphs that do not use the new model-answer terms validate and report as before; the new FAIL rules look only at aiprov:modelRole and aiprov:fallbackOf, so a file entity regenerated by several legacy activities is not flagged (test_legacy_graph_is_unchanged)."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-multi-model-answers> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/multi-model-refusals-leave-graph> a aiprov:Claim ;
    rdfs:label "A log call with an unlogged or self-referencing fallback target, an orphaned fallback reason, or an unpaired judge/score leaves the graph file byte-identical (test_log_refuses_what_makes_no_sense)."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-multi-model-answers> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/rebase-composite-36-textual-only> a aiprov:Claim ;
    rdfs:label "The rebase of the composite-claims branch onto main resolved textual conflicts only (both sides kept in the changelog, the validate section and the graph); the 110 tests of the suite pass and validate shows no FAIL."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-11-07-rebase-composite-36> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/session-types-legacy-unchanged> a aiprov:Claim ;
    rdfs:label "Graphs that do not use dcterms:isPartOf on an activity validate and report exactly as before the session change (checked by test_legacy_graph_without_sessions_is_unchanged and by the existing 36 tests, which pass unchanged)."@en ;
    prov:wasAttributedTo agent:claude-sonnet-5-5 ;
    prov:wasGeneratedBy <https://w3id.org/aiprov/prov/activity/2026-10-30-session-types> ;
    aiprov:verificationState verif:unverified .

<https://w3id.org/aiprov/prov/claim/session-types-write-once> a aiprov:Claim ;
    rdfs:label "A session's type, outcome, start and end are write-once: a different second value is refused and the graph file stays byte-identical (test_session_values_are_write_once)."@en ;
